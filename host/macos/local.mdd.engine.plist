<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for the privileged engine daemon. Rendered by
     host/macos/install-launchd.sh (placeholders @...@ replaced with the
     actual home/repo/build paths) into /Library/LaunchDaemons. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.mdd.engine</string>
    <key>ProgramArguments</key>
    <array>
        <string>@BUILD@/venv/bin/python</string>
        <string>-u</string>
        <string>@REPO@/host/macos/mdd_engine_daemon.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>MDD_DATA</key>
        <string>@BUILD@/data</string>
        <key>MDD_REPO</key>
        <string>@REPO@</string>
        <key>MDD_VENV</key>
        <string>@BUILD@/venv</string>
        <key>MDD_AST_STAGE</key>
        <string>@BUILD@/asterisk-stage</string>
        <key>MDD_SOCKET_USER</key>
        <string>@USER@</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>@BUILD@/data/logs/engine-daemon.log</string>
    <key>StandardErrorPath</key>
    <string>@BUILD@/data/logs/engine-daemon.log</string>
</dict>
</plist>
